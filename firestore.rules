rules_version = '2';
// SBK app security rules. Replace FOUNDER_EMAIL below with the Founder's sign-up email.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isFounder() {
      return signedIn() && request.auth.token.email == 'FOUNDER_EMAIL' && request.auth.token.email_verified == true;
    }
    function hasProfile() { return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)); }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isMember() { return isFounder() || (hasProfile() && me().status == 'member'); }
    function isStaff() { return isFounder() || (hasProfile() && me().status == 'member' && me().role in ['founder', 'leader']); }

    match /users/{uid} {
      allow read: if isMember() || (signedIn() && request.auth.uid == uid);
      // new accounts always start as pending members
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'epic', 'status', 'role', 'createdAt'])
        && request.resource.data.status == 'pending' && request.resource.data.role == 'member'
        && request.resource.data.name is string && request.resource.data.name.size() >= 2 && request.resource.data.name.size() <= 24
        && request.resource.data.epic is string && request.resource.data.epic.size() <= 32;
      // founder can change status and role; leaders can only change status of non-staff
      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'role'])
        && (isFounder()
            || (isStaff() && request.resource.data.role == resource.data.role && resource.data.role == 'member'
                && request.resource.data.status in ['member', 'banned']));
    }

    // age is private: only the person and staff can see it
    match /private/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isStaff();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['age', 'createdAt'])
        && request.resource.data.age is int && request.resource.data.age >= 13 && request.resource.data.age <= 99;
    }

    match /channels/{ch}/messages/{id} {
      allow read: if isMember() && ch in ['announcements', 'general', 'lfg', 'clips', 'wins'];
      allow create: if isMember()
        && ch in ['announcements', 'general', 'lfg', 'clips', 'wins']
        && (ch != 'announcements' || isStaff())
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.name == me().name
        && request.resource.data.role == me().role
        && request.resource.data.text is string && request.resource.data.text.size() <= 1000
        && (!('image' in request.resource.data) || (request.resource.data.image is string && request.resource.data.image.size() < 900000));
      allow delete: if isStaff() || (isMember() && resource.data.uid == request.auth.uid);
    }

    match /reports/{id} {
      allow create: if isMember() && request.resource.data.reporter == request.auth.uid;
      allow read, delete: if isStaff();
    }
  }
}
